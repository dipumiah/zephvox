{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zephvox",
  "version": "0.1.0",
  "identifier": "io.github.zephvox.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "zephvox",
        "url": "index.html",
        "width": 1100,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "Find and practice your English pronunciation and grammar mistakes",
    "longDescription": "Record yourself speaking English and see the sounds and sentences to work on. Everything runs on your computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/**/*"],
    "macOS": { "entitlements": "Entitlements.plist", "minimumSystemVersion": "12.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBLIC_KEY",
      "endpoints": ["https://github.com/dipoahmed018/zephvox/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
